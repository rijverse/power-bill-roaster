# Dependencies
node_modules/
# legacy binary lockfile - we track the text bun.lock now; an older bun would
# regenerate this, so keep it out of the repo
bun.lockb

# Build output
dist/

# Environment variables
.env
.env.local
.env.*.local

# Local docker-compose overrides (host-port remaps etc.) - machine-specific,
# auto-merged by `docker compose up`, so never commit it
docker-compose.override.yml

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Coverage
coverage/

# Private notes (business/cost details, never public)
*.private.md
