# saas server mode (src/index.ts: Telegram bot + scheduler)
# Production: use managed Postgres (e.g. Neon) and keep sslmode=require so the
# link is encrypted - the app refuses a remote DB without it.
DATABASE_URL=postgres://powerroast:powerroast@localhost:5432/powerroast
# sslmode can also be declared here instead of in the URL
#PGSSLMODE=require
# max pooled Postgres connections (default 10)
#DB_POOL_MAX=10
# set to 1 to allow a remote DB without TLS - only on a private network you trust
#ALLOW_INSECURE_DB=
TELEGRAM_BOT_TOKEN=
# mock mode: uncomment to develop against the Mockoon container from
# docker-compose (set TELEGRAM_BOT_TOKEN=test-token, nothing real is contacted)
#TELEGRAM_API_ROOT=http://localhost:8080
#DESCO_API_BASE_URL=http://localhost:8080/api/tkdes/customer
#POLL_INTERVAL_HOURS=0.01
# optional: Telegram chat id that receives operator alarms (API health etc.)
ADMIN_CHAT_ID=
# optional: Discord user id that also receives operator alarms + dead-letter
# pings. Set this (and/or ADMIN_CHAT_ID) so a Discord-only deploy still gets
# paged; leaving both empty means no operator alarms.
#ADMIN_DISCORD_USER_ID=
POLL_INTERVAL_HOURS=6
REMINDER_INTERVAL_HOURS=24
JITTER_MAX_MS=4000

# DESCO upstream TLS verification. Default is on (safe). DESCO's certificate
# chain has historically been flaky; if real upstream calls start failing with
# certificate errors, set DESCO_TLS_INSECURE=1 to skip verification. This is
# scoped to the DESCO client only; everything else still verifies normally.
#DESCO_TLS_INSECURE=

# Discord bot (optional): slash commands + DM alerts, alongside Telegram. Set
# all three from the Discord developer portal (General Information page), or
# none - a partial set is treated as a typo and refuses to boot. After boot,
# put PUBLIC_BASE_URL/discord/interactions into the portal's "Interactions
# Endpoint URL" (needs public HTTPS - see docs/DEPLOY.md).
#DISCORD_APP_ID=
#DISCORD_PUBLIC_KEY=
#DISCORD_BOT_TOKEN=
# override the Discord REST root (mock servers only)
#DISCORD_API_BASE_URL=

# SMS channel (optional). Unset = SMS disabled. "console" logs instead of
# sending (dev); "bulksmsbd" sends for real and needs the two creds below.
#SMS_GATEWAY=console
#BULKSMSBD_API_KEY=
#BULKSMSBD_SENDER_ID=

# HTTP listen port (health endpoint, web app, payment callbacks)
#PORT=3000

# Web dashboard links (sent by the /dashboard bot command)
# Set to your public URL in production, e.g. https://app.example.com
#PUBLIC_BASE_URL=http://localhost:3000
# Bot's @username (without the @). Powers t.me/<username> links on the web app
# and the expired-dashboard page. Leave blank to hide those links.
#BOT_USERNAME=
# Optional: explicit signing secret (defaults to a hash of the bot token)
#DASHBOARD_SECRET=
# Set to 1 only when the app runs behind a reverse proxy you control (e.g. Caddy)
# that sets X-Forwarded-For. It tells the login and magic-link rate limiters to
# key off that header instead of the socket address. Leave unset if the container
# port is exposed directly - otherwise a client can spoof the header to dodge the
# per-IP throttles.
#TRUST_PROXY=

# Operator admin dashboard at /admin (browse & manage customers). Blank = the
# whole /admin panel is disabled (404). Set a strong password and only ever
# expose /admin over HTTPS - it shows customer PII.
#ADMIN_PASSWORD=

# Customer web app at /app (sign up & manage meters without Telegram). It uses
# passwordless email sign-in, so it needs outbound email: set SMTP_HOST +
# EMAIL_FROM (and SMTP_USER/PASS/PORT) below. With those set, email LOW/CRITICAL
# alerts also turn on for web users. Unset = /app sign-in and email alerts are
# both off. PUBLIC_BASE_URL (above) is where the magic-link points - HTTPS in prod.

# Billing. "none" (default) = paid plans off; /upgrade says "coming soon" and
# no money or plan changes hands (the safe free-only launch setting). "sandbox"
# auto-approves upgrades for free - dev/testing ONLY, never production. bkash and
# sslcommerz are live; both need PUBLIC_BASE_URL set to a reachable (HTTPS in
# production) origin - payment callbacks land on /pay/* there.
#BILLING_PROVIDER=none
# bKash Tokenized Checkout. BKASH_BASE_URL defaults to the sandbox host.
#BKASH_APP_KEY=
#BKASH_APP_SECRET=
#BKASH_USERNAME=
#BKASH_PASSWORD=
#BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
# SSLCommerz hosted checkout. SSLCOMMERZ_BASE_URL defaults to the sandbox host.
#SSLCOMMERZ_STORE_ID=
#SSLCOMMERZ_STORE_PASSWORD=
#SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com

# default thresholds for new registrations (also used by self-hosted mode)
LOW_THRESHOLD=150
CRITICAL_THRESHOLD=100

# DESCO recharge URL embedded in alert messages. Defaults to the public portal;
# override only if DESCO changes their URL or you're pointing at a mirror.
#RECHARGE_URL=https://prepaid.desco.org.bd/

# roast intensity for self-hosted mode: savage (default) or mild. No effect in
# server mode - the hosted app stores tone per user in the DB.
#ALERT_TONE=savage

# self-hosted single-user mode (src/cli.ts, free via GitHub Actions). Configure
# at least one alert channel below - Discord (one secret) and/or email (SMTP).
DESCO_ACCOUNT_NO=
DESCO_METER_NO=
# Discord: create a webhook (Server Settings > Integrations > Webhooks > New
# Webhook > Copy URL) and paste it here. The simplest channel - no SMTP needed.
DISCORD_WEBHOOK_URL=
# Email (SMTP): set all five together (e.g. EMAIL_TO=you@example.com,
# EMAIL_FROM=alerts@example.com), or leave them all blank to skip email.
EMAIL_TO=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
